/* pages/login/index.wxss */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #4A90E2 0%, #357ABD 100%);
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.title {
  margin-top: 32rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录区域 */
.login-section {
  width: 100%;
  margin-top: 60rpx;
}

.agreement {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.agreement-label checkbox {
  transform: scale(0.8);
}

.agreement-label .link {
  color: #FFD700;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #fff;
  color: #4A90E2;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.login-btn.disabled {
  background: rgba(255, 255, 255, 0.5);
  color: rgba(74, 144, 226, 0.5);
}

/* 授权区域 */
.auth-section {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.auth-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 48rpx;
}

/* 头像选择 */
.avatar-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 4rpx dashed #ddd;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* 昵称输入 */
.nickname-wrapper {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 48rpx;
}

.nickname-wrapper .label {
  width: 120rpx;
  font-size: 30rpx;
  color: #333;
}

.nickname-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 24rpx;
}

.submit-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #4A90E2;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}
