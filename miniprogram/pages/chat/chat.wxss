page {
  background-color: #f5f5f5;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat-content {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.chat-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.chat-item-left {
  flex-direction: row;
}

.chat-item-right {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  margin: 0 10rpx;
}

.bubble {
  max-width: 60%;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  line-height: 1.4;
  word-break: break-all;
}

.chat-item-left .bubble {
  background-color: #ffffff;
  color: #333;
}

.chat-item-right .bubble {
  background-color: #95ec69; /* 微信绿 */
  color: #000;
}

/* 底部输入栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.input-box {
  flex: 1;
  background-color: #ffffff;
  height: 70rpx;
  border-radius: 10rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #07c160;
  color: white;
  font-size: 28rpx;
  padding: 0;
  border-radius: 10rpx;
}