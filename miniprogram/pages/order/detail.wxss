/* pages/order/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 状态卡片 */
.status-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  color: #fff;
}

.status-card.status-0 {
  background: linear-gradient(135deg, #ff9500 0%, #ff7b00 100%);
}

.status-card.status-1 {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
}

.status-card.status-2 {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.status-card.status-3 {
  background: linear-gradient(135deg, #999 0%, #777 100%);
}

.status-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.status-info {
  display: flex;
  flex-direction: column;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
}

.status-desc {
  font-size: 26rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

/* 通用section样式 */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 商品卡片 */
.goods-card {
  display: flex;
  align-items: center;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price {
  font-size: 34rpx;
  color: #ff4d4f;
  font-weight: 500;
  margin-top: 12rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.user-card:last-child {
  border-bottom: none;
}

.user-label {
  width: 80rpx;
  font-size: 26rpx;
  color: #999;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.user-tag {
  font-size: 22rpx;
  color: #4A90E2;
  background-color: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* 信息项 */
.info-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.copy-btn {
  font-size: 24rpx;
  color: #4A90E2;
  padding: 8rpx 16rpx;
  background-color: #e6f7ff;
  border-radius: 4rpx;
}

/* 留言内容 */
.message-content,
.location-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  max-width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
}

.btn-primary {
  background-color: #4A90E2;
  color: #fff;
}

.btn-chat {
  background-color: #fff;
  color: #4A90E2;
  border: 1rpx solid #4A90E2;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
