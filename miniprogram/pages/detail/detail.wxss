/* pages/detail/detail.wxss */
.container {
  background: #f5f5f5;
}

.detail-scroll {
  height: calc(100vh - 120rpx);
  padding-bottom: 20rpx;
}

/* 图片轮播 */
.book-swiper {
  width: 100%;
  height: 700rpx;
  background: #fff;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 信息卡片 */
.info-card {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.book-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
}

.book-meta {
  display: flex;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.book-author {
  margin-right: 30rpx;
}

.book-price-box {
  display: flex;
  align-items: baseline;
  margin-top: 24rpx;
}

.current-price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-right: 20rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.book-tags-box {
  display: flex;
  margin-top: 24rpx;
}

/* 卖家卡片 */
.seller-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.seller-info {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.seller-detail {
  flex: 1;
}

.seller-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.seller-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.certified-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.contact-btn {
  padding: 16rpx 32rpx;
  background: #4A90E2;
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
}

/* 详情卡片 */
.detail-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.detail-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  width: 160rpx;
  color: #999;
}

.detail-value {
  flex: 1;
  color: #333;
}

/* 描述卡片 */
.desc-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.bar-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #666;
}

.buy-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
}
