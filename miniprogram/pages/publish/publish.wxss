/* pages/publish/publish.wxss */
.container {
  background: #f5f5f5;
}

.publish-scroll {
  height: calc(100vh - 140rpx);
}

/* 快速识别 */
.quick-scan-box {
  margin: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 12rpx;
}

.scan-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 24rpx;
}

.scan-buttons {
  display: flex;
  gap: 20rpx;
}

.scan-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  color: #fff;
  font-size: 26rpx;
}

.scan-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
}

/* 表单区域 */
.form-section {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 图片上传 */
.upload-box {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-icon {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
}

.upload-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

/* 输入框 */
.input-wrapper {
  margin-bottom: 30rpx;
}

.input-wrapper:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.price-input {
  position: relative;
}

.price-unit {
  position: absolute;
  right: 24rpx;
  color: #999;
}

.price-suggest {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff6b6b;
}

.picker {
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 24rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  text-align: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-sizing: border-box;
}
